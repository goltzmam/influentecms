# Configuração web (Supabase local ou projeto hospedado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=https://cms.suaempresa.com.br
# Opcional: domínio wildcard DNS associado ao projeto Vercel, sem esquema.
PORTAL_BASE_DOMAIN=
# Somente servidor: provisionamento inicial e verificação de domínios.
SUPABASE_SERVICE_ROLE_KEY=
# Somente no processo de criação do administrador; remova depois.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integração oficial de domínios Vercel; somente no servidor.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Gemini: somente servidor, nunca usar prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional; usa Gemini 3.6 Flash quando ausente.
GEMINI_MODEL=

# Envio de convites sem domínio próprio: Gmail com senha de aplicativo.
# Somente Production; nunca usar a senha normal do Google ou da plataforma.
MAIL_FROM=
MAIL_FROM_NAME=Influente
GMAIL_APP_PASSWORD=
# Alternativa: Resend exige remetente verificado; ou credenciais SMTP do seu provedor.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_RATE_LIMIT=30
