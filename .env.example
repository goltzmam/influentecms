# Configuração web (Supabase local ou projeto hospedado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=https://cms.suaempresa.com.br
# Opcional: domínio wildcard DNS associado ao projeto Vercel, sem esquema.
PORTAL_BASE_DOMAIN=
# Somente servidor: provisionamento inicial e verificação de domínios.
SUPABASE_SERVICE_ROLE_KEY=
# Somente no processo de criação do administrador; remova depois.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integração oficial de domínios Vercel; somente no servidor.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
