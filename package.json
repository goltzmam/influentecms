    "test:e2e": "playwright test",
    "supabase:start": "node scripts/start-local.mjs",
    "supabase:stop": "supabase stop",
    "local:env": "node scripts/local-env.mjs",
    "release:configure": "node --use-env-proxy scripts/release.mjs configure",
    "release:migrate": "node --use-env-proxy scripts/release.mjs migrate",
    "release:deploy": "node --use-env-proxy scripts/release.mjs deploy",
    "release:status": "node --use-env-proxy scripts/release.mjs status",
    "build:vercel": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
